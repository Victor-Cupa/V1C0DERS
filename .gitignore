# See https://docs.github.com/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# ---------------------------------------------------------
# 1. COMPILED OUTPUT & CACHE
# ---------------------------------------------------------
/dist
/tmp
/out-tsc
/bazel-out
/.angular/cache
.sass-cache/
/coverage

# ---------------------------------------------------------
# 2. DEPENDENCIES (NODE & PYTHON)
# ---------------------------------------------------------
/node_modules
venv/
.venv/
env/
__pycache__/
*.py[cod]
*$py.class

# ---------------------------------------------------------
# 3. SECURITY & SECRETS (CRÍTICO)
# ---------------------------------------------------------
.env
.env.local
.env.production
*.pem

# ---------------------------------------------------------
# 4. SERVERLESS & NETLIFY
# ---------------------------------------------------------
.netlify/

# ---------------------------------------------------------
# 5. LOGS
# ---------------------------------------------------------
npm-debug.log*
yarn-error.log
/libpeerconnection.log
testem.log

# ---------------------------------------------------------
# 6. IDEs & EDITORS
# ---------------------------------------------------------
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
.history/*

# Visual Studio Code (Excepciones específicas)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/mcp.json

# ---------------------------------------------------------
# 7. OS SYSTEM FILES & MISC
# ---------------------------------------------------------
.DS_Store
Thumbs.db
/connect.lock
/typings
__screenshots__/